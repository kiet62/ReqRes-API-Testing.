        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Check name and job in response\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "\r",
                  "    pm.expect(jsonData.name).to.eql(\r",
                  "        pm.iterationData.get(\"name\")\r",
                  "    );\r",
                  "\r",
                  "    pm.expect(jsonData.job).to.eql(\r",
                  "        pm.iterationData.get(\"job\")\r",
                  "    );\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Extract and set userId\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "\r",
                  "    pm.expect(jsonData.id).to.exist;\r",
                  "\r",
                  "    pm.environment.set(\"userId\", jsonData.id);\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
